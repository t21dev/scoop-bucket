{
    "version": "1.7.1",
    "description": "A fast, native reader for PDF, ebooks, comics and Markdown. Rust and GPUI, pages by MuPDF.",
    "homepage": "https://kitab.t21.dev",
    "license": "AGPL-3.0-or-later",
    "notes": [
        "Kitab runs in portable mode under Scoop: your library and settings live in",
        "$persist_dir\\data and survive updates.",
        "The kitab command opens files in Kitab, and runs its tools (kitab help).",
        "Quit Kitab before `scoop update kitab`."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/t21dev/kitab/releases/download/v1.7.1/Kitab_1.7.1_x64_portable.zip",
            "hash": "65cf5fb28b633c5a443ea10c2d16605a1a418cbd0a94e759022c432b6df2c5b5"
        }
    },
    "extract_dir": "Kitab",
    "bin": [
        [
            "bin\\kitab.exe",
            "kitab"
        ]
    ],
    "shortcuts": [
        [
            "kitab.exe",
            "Kitab Reader"
        ]
    ],
    "persist": "data",
    "uninstaller": {
        "script": [
            "# Uninstalling (not updating): file types and right-click tools that open this copy come off.",
            "if ($cmd -eq 'uninstall') {",
            "    Start-Process -FilePath \"$dir\\kitab.exe\" -ArgumentList '--unregister' -Wait -WindowStyle Hidden -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/t21dev/kitab"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/t21dev/kitab/releases/download/v$version/Kitab_$version_x64_portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
